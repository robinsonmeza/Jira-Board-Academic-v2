# BEDROCK_API_KEY: Primary AI engine (Amazon Bedrock API Key).
# Configured with BedrockAPIKey for fast LLM inference.
BEDROCK_API_KEY=""
BEDROCK_REGION="us-east-1"

# NVIDIA_API_KEY: Secondary AI engine (NVIDIA NIM fallback & code review).
# Users configure this via the Settings / Secrets panel in AI Studio.
NVIDIA_API_KEY=""

# GEMINI_API_KEY: Optional auxiliary Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
